# Required for AI analysis
NVIDIA_API_KEY=
# NVIDIA NIM chat-completions model (verify availability in your NVIDIA API catalog)
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional NVIDIA hosted ASR endpoint URL from build.nvidia.com.
# If configured, VoxNote tries this first for audio transcription.
NVIDIA_ASR_URL=

# Gemini is used automatically if NVIDIA fails or is not configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: maximum audio upload size in MB (inline Gemini audio request)
MAX_AUDIO_MB=15
